DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=turkicgrammarai.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://turkicgrammarai.example.com
CORS_ALLOWED_ORIGINS=https://turkicgrammarai.example.com

POSTGRES_DB=turkicgrammarai
POSTGRES_USER=turkicgrammarai
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://turkicgrammarai:replace-with-strong-password@postgres:5432/turkicgrammarai

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

DRF_ANON_THROTTLE=120/min
DRF_USER_THROTTLE=600/min
SECURE_SSL_REDIRECT=True
