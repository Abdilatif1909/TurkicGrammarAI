DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-with-at-least-32-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=turkicgrammarai
POSTGRES_USER=turkicgrammarai
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://turkicgrammarai:change-me-local-db-password@postgres:5432/turkicgrammarai
# Optional for quick local checks outside Docker:
# USE_SQLITE=True

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-local-admin-password
